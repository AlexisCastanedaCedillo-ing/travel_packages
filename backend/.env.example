# Backend NestJS ejecutado directamente en Windows.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL: los valores deben coincidir con los configurados para Compose
# en el .env de la raíz. Usa localhost desde el backend ejecutado en Windows.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=travel_packages
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=replace_with_a_local_password

# Genera un secreto local de al menos 32 caracteres antes de implementar JWT.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Required only when running npm run seed:run.
# All the password values should be 12 characters long.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_local_password
SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=replace_with_a_local_password
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=replace_with_a_local_password

# Redis, accesible desde Windows por el puerto publicado por Compose.
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ, accesible desde Windows por el puerto AMQP publicado por Compose.
# Mantén usuario y contraseña sincronizados con el .env de la raíz.
RABBITMQ_HOST=localhost
RABBITMQ_USER=travel_user
RABBITMQ_PASSWORD=replace_with_a_local_password
RABBITMQ_PORT=5672

# Opcionales: solo si conectas NestJS Observe.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

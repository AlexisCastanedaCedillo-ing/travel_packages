
# Conexiones locales para ejecutar el backend directamente en tu computadora.
# Si el backend se ejecuta en Docker, usa los nombres de los servicios de Compose como hosts.
POSTGRES_HOST=localhost
RABBITMQ_HOST=localhost

# Solo para desarrollo local. Cambia estos valores antes de desplegar.
POSTGRES_DB=travel_packages
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=local_only_change_this
POSTGRES_PORT=5433

RABBITMQ_USER=travel_user
RABBITMQ_PASSWORD=local_only_change_this
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PORT=6379
API_PORT=3000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=local_only_change_this_jwt_secret_with_at_least_32_characters

# Opcional: solo para crear datos locales de demostración con seed:run:prod.
SEED_ADMIN_EMAIL=admin@viajeslili.test
SEED_ADMIN_PASSWORD=AdminDemo2026!
SEED_AGENT_EMAIL=agente@viajeslili.test
SEED_AGENT_PASSWORD=AgentDemo2026!
SEED_CUSTOMER_EMAIL=cliente@viajeslili.test
SEED_CUSTOMER_PASSWORD=ClienteDemo2026!

# Opcional: configura estas claves mediante GitHub Secrets/variables en CI y producción.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

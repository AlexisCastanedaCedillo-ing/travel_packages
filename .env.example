# Entorno de ejecución (normalmente: development)
NODE_ENV=
# Puerto de la API (normalmente: 3000)
PORT=

# Local connections for running the backend directly on your computer.
# If the backend runs in Docker, use the Compose service names as hosts.

# Base de datos PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Usa localhost si ejecutas el backend en tu equipo; dentro de Docker, postgres.
POSTGRES_HOST=
# PostgreSQL: puerto por defecto 5432
POSTGRES_PORT=

# Genera una clave privada de al menos 32 caracteres.
JWT_SECRET=

# Redis: usa localhost desde tu equipo o redis dentro de Docker.
REDIS_HOST=
# Redis: puerto por defecto 6379
REDIS_PORT=

# RabbitMQ: usa credenciales iguales a las configuradas para el servicio.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# RabbitMQ: AMQP por defecto 5672; panel de administración 15672
RABBITMQ_PORT=
RABBITMQ_MANAGEMENT_PORT=
# Formato: amqp://usuario:contraseña@host:puerto
RABBITMQ_URL=
